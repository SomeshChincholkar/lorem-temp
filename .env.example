# Copy to .env and fill in. .env is gitignored; this file is not.

# --- AWS Bedrock (primary LLM) -----------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Spec: Nova Lite primary, Cohere Command R+ fallback.
BEDROCK_MODEL_ID=cohere.command-r-plus-v1:0
BEDROCK_MODEL_ID_MULTILINGUAL=amazon.nova-lite-v1:0

# --- MCP servers -------------------------------------------------------
PRIMARY_MCP_URL=http://localhost:8200/clinicaltools
SECONDARY_MCP_URL=http://localhost:8201/analyticstools

# Folder registered as the MCP Root by every agent's client session.
# Must match the folder the Watcher/Harvester tools scan.
INPUT_ROOT_DIR=Data/incoming

# --- Mock EHR ----------------------------------------------------------
MOCK_EHR_URL=http://localhost:8050

# --- A2A ---------------------------------------------------------------
# Shared secret sent as X-Agent-Auth-Token on every A2A request.
AGENT_AUTH_TOKEN=dev-secret-change-me
EXTRACTOR_AGENT_URL=http://localhost:8100
VALIDATOR_AGENT_URL=http://localhost:8101
NORMALIZER_AGENT_URL=http://localhost:8102
MONITOR_AGENT_URL=http://localhost:8103
SUMMARY_AGENT_URL=http://localhost:8104
RAG_AGENT_URL=http://localhost:8105
ORCHESTRATOR_URL=http://localhost:8083

# --- LangFuse observability -------------------------------------------
# Leave both keys blank to run untraced -- every tracing call no-ops.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- A2A push notifications -------------------------------------------
# Webhook receiving discharge.reviewed events. Blank disables them.
# Requests carry X-Agent-Auth-Token plus an HMAC in X-Agent-Signature.
PUSH_NOTIFICATION_URL=

# --- HITL elicitation --------------------------------------------------
# How long the Validation Agent waits for a reviewer before declining.
# Set to 0 for unattended runs so nothing blocks.
ELICITATION_TIMEOUT_SECONDS=120
